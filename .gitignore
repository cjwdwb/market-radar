# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 安装依赖及包管理器本地缓存
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试覆盖率产物
/coverage

# 框架构建产物
/.next/
/out/

# 系统文件与证书
.DS_Store
*.pem

# 本地调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境配置默认忽略，仅提交无真实值的示例
.env*
!.env.example

# vercel
.vercel

# 类型检查缓存与框架生成声明
*.tsbuildinfo
next-env.d.ts
# 构建、运行缓存、原始验证产物与本地归档
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# 项目内个人资料与备份不上传Git；占位文件仅保留目录结构
/data/local/*
!/data/local/.gitkeep

# 本地Worker预览密钥，禁止提交真实值
.dev.vars*
